# cp .env.example .env, then generate a key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Boot fails loudly if SECRET_KEY is empty while DEBUG=False (SEC-08).
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://souqi:souqi@db:5432/souqi
CORS_ORIGINS=http://localhost:3000
AI_PROVIDER_KEY=
LOW_STOCK_THRESHOLD=5
# Set true only behind a TLS-terminating proxy: enables HSTS, SSL redirect, secure cookies.
HTTPS_ONLY=False
